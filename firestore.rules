rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile collection:
    // - Authenticated users can view other members' dating profiles to discover & swipe.
    // - Users can ONLY create, edit, or delete their own profile matching their Firebase Auth UID.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Matches collection:
    // - Only participants of the match can read or update the conversation state.
    match /matches/{matchId} {
      allow read: if request.auth != null && (
        resource == null || request.auth.uid in resource.data.users
      );
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.users || request.auth.uid in request.resource.data.users
      );
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Direct Messages collection:
    // - Authenticated users can read messages for matches they are part of.
    // - Senders can only author messages stamped with their own Auth UID.
    match /messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.senderId;
    }

    // Swipes record:
    // - Users can only log swipes from their own authenticated account.
    match /swipes/{swipeId} {
      allow read: if request.auth != null && (
        resource == null ||
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUserId;
    }

    // Safety and user reports:
    // - Any logged in user can submit a report against suspicious accounts.
    match /reports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterUid;
      allow read: if request.auth != null && request.auth.uid == resource.data.reporterUid;
    }

    // Notifications:
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null;
    }
  }
}
